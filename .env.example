# Copiar a .env.local y completar con los datos del proyecto de Supabase.

# Project Settings → API. La app usa solo estas dos: todo pasa por RLS.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo para los scripts (seed). Nunca se usa en la app.
SUPABASE_SERVICE_ROLE_KEY=

# Connect → Session pooler. Para migraciones y seed.
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-xx.pooler.supabase.com:5432/postgres
